# Salin menjadi backend/.env lalu isi JWT_SECRET_KEY dengan string acak panjang, mis:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Opsional. Default: backend/instance/finanku.db
# DATABASE_URL=sqlite:///C:/path/ke/finanku.db

# Opsional. Masa berlaku access token dalam detik (default 900 = 15 menit)
# JWT_ACCESS_SECONDS=900

# Opsional. Batas percobaan login & pendaftaran (nilai default di bawah)
# LOGIN_MAX_FAILURES_PER_USER=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_WINDOW_SECONDS=900
# REGISTER_MAX_PER_IP=10
# REGISTER_WINDOW_SECONDS=3600

# Jika di produksi Flask berada di belakang reverse proxy (nginx, Caddy, ...), isi jumlah proxy-nya
# agar pembatasan per-IP memakai IP asli pengunjung, bukan IP proxy
# TRUSTED_PROXY_COUNT=1

# Set ke 1 jika disajikan lewat HTTPS (cookie refresh hanya dikirim via HTTPS)
# JWT_COOKIE_SECURE=1
