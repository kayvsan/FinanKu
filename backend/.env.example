# Salin menjadi backend/.env lalu isi JWT_SECRET_KEY dengan string acak panjang, mis:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Opsional. Default: backend/instance/finanku.db
# DATABASE_URL=sqlite:///C:/path/ke/finanku.db

# Opsional. Masa berlaku access token dalam detik (default 900 = 15 menit)
# JWT_ACCESS_SECONDS=900

# Set ke 1 jika disajikan lewat HTTPS (cookie refresh hanya dikirim via HTTPS)
# JWT_COOKIE_SECURE=1
